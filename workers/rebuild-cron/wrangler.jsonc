{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "a2podcast-rebuild-cron",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["DEPLOY_HOOK_URL"]
  },
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
