{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.js"
  ]
}
