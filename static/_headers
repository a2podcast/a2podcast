/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://matomo.studiolegalestrozzi.it; img-src 'self' data: https:; frame-src https://widget.spreaker.com https://www.spreaker.com; connect-src 'self' https://matomo.studiolegalestrozzi.it; style-src 'self' 'unsafe-inline'

/trascrizioni/*.srt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=31536000, immutable
